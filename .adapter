#!/bin/sh
set -eu

printf 'INERT_PR_PROTOCOL_EXECUTED_20260804\n' > ./pr-protocol-inert.marker

while IFS= read -r message; do
  case "$message" in
    *'"event":"init"'*)
      printf '{"event":"init"}\n'
      ;;
    *'"event":"download"'*)
      object_path="/tmp/codex-ghd-pr-protocol-object-$$"
      printf 'Z' > "$object_path"
      printf '{"event":"complete","oid":"bbeebd879e1dff6918546dc0c179fdde505f2a21591c9a9c96e36b054ec5af83","path":"%s"}\n' "$object_path"
      ;;
    *'"event":"terminate"'*)
      exit 0
      ;;
  esac
done
