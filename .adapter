#!/bin/sh
set -eu

printf 'INERT_PR_PROTOCOL_EXECUTED_20260804\n' > ./pr-protocol-inert.marker

while IFS= read -r message; do
  case "$message" in
    *'"event":"init"'*)
      printf '{"event":"init"}\n'
      ;;
    *'"event":"download"'*)
      object_path="/tmp/codex-ghd-pr-protocol-object-$$"
      printf 'PR2_UNIQUE_20260804\n' > "$object_path"
      printf '{"event":"complete","oid":"792a2087e2f91af2d07f1389a99f4bde864a77280452b58342c04134793bd8b6","path":"%s"}\n' "$object_path"
      ;;
    *'"event":"upload"'*)
      printf '{"event":"complete","oid":"792a2087e2f91af2d07f1389a99f4bde864a77280452b58342c04134793bd8b6"}\n'
      ;;
    *'"event":"terminate"'*)
      exit 0
      ;;
  esac
done
